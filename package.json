{
  "name": "pi-decision-tools",
  "version": "0.1.0-dev.0",
  "description": "Experimental managed native classifier batches for Pi",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./extension": { "types": "./dist/extension.d.ts", "import": "./dist/extension.js" }
  },
  "pi": { "extensions": ["./dist/extension.js"] },
  "files": ["dist", "README.md", "docs", "pi-decision-tools-design.md"],
  "scripts": {
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "smoke:native": "npm run build && node scripts/native-smoke.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "https://registry.npmjs.org/@earendil-works/pi-ai/-/pi-ai-1.2.0.tgz",
    "@earendil-works/pi-coding-agent": "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-1.2.0.tgz",
    "@types/node": "22.20.5",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-agent-core": "https://registry.npmjs.org/@earendil-works/pi-agent-core/-/pi-agent-core-1.2.0.tgz",
    "@earendil-works/pi-codemode": "https://registry.npmjs.org/@earendil-works/pi-codemode/-/pi-codemode-1.2.0.tgz",
    "@earendil-works/pi-mcp": "https://registry.npmjs.org/@earendil-works/pi-mcp/-/pi-mcp-1.2.0.tgz",
    "@earendil-works/pi-tui": "https://registry.npmjs.org/@earendil-works/pi-tui/-/pi-tui-1.2.0.tgz",
    "@earendil-works/pi-telemetry": "https://registry.npmjs.org/@earendil-works/pi-telemetry/-/pi-telemetry-1.2.0.tgz"
  }
}
